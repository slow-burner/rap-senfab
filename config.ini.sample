; 계측 사전 지정 부하 모니터 DB 접속 정보
; 이 파일을 config.ini 로 복사해 exe 폴더 옆(또는 app.py 옆)에 두고 값을 채운다.
; data_source.USE_SAMPLE = False 로 바꾸면 이 값으로 접속한다.
; config.ini 는 .gitignore 에 있어 저장소에 올라가지 않는다.
[mysql]
host = 10.0.0.1
port = 3306
user = metro_ro
password =
database = fab

[bdq]
; 사내 bigdataquery 설정이 따로 있으면 여기에 둔다
cluster =
